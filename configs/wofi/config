# Layout
width=540
# Use an explicit height so filtering never resizes or repositions the menu.
height=380
dynamic_lines=false
location=center

# Search and interaction
matching=fuzzy
insensitive=true
hide_scroll=true
gtk_dark=true
close_on_focus_loss=true
single_click=true
filter_rate=50
image_size=28
term=alacritty

# Vim-style navigation
key_down=Ctrl-j,Ctrl-n
key_up=Ctrl-k,Ctrl-p
